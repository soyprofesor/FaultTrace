<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Library dependencies: lowest versions that work on .NET Core 3.1. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="3.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="3.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="3.1.0" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="4.7.0" />
    <PackageVersion Include="PolySharp" Version="1.15.0" />
  </ItemGroup>

  <!-- Test dependencies: last versions that still support netcoreapp3.1. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.4.5" Condition="'$(TargetFramework)' == 'netcoreapp3.1'" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" Condition="'$(TargetFramework)' != 'netcoreapp3.1'" />
  </ItemGroup>

  <!-- Only the integration tests talk to a real database. The library itself never references ODP.NET. -->
  <ItemGroup>
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <!-- ODP.NET still brings 8.0.1, which has known vulnerabilities. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

  <!-- TestHost is versioned together with the ASP.NET Core shared framework. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="3.1.32" Condition="'$(TargetFramework)' == 'netcoreapp3.1'" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="6.0.36" Condition="'$(TargetFramework)' == 'net6.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.31" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

</Project>
