{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Oracle": ""
  },
  "FaultTrace": {
    "DefaultCulture": "en",
    "DetailExposure": "DevelopmentOnly",
    "HandleEmptyStatus": true,
    "RetryAfterSeconds": 5,
    "Culture": {
      "HeaderNames": [ "X-Culture" ]
    }
  }
}
